@{
    ViewBag.Title = "Login";
}

<div class="login-wrapper">
    <div class="login-card">
        <h2>Welcome Back</h2>
        <p class="login-subtext">Log in to access your dashboard</p>

        @if (ViewBag.Error != null)
        {
            <div class="login-error">@ViewBag.Error</div>
        }

        @if (TempData["Success"] != null)
        {
            <div class="login-error" style="background:#14532d; border-color:#22c55e; color:#bbf7d0;">@TempData["Success"]</div>
        }

        @using (Html.BeginForm("Login", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div class="form-group-custom">
                <label>Username or Email</label>
                <input type="text" name="username" class="form-control-custom" placeholder="Username or email" autofocus />
            </div>
            <div class="form-group-custom">
                <label for="loginPassword">Password</label>
                <div class="pw-wrap">
                    <input type="password" id="loginPassword" name="password" class="form-control-custom" placeholder="Password" autocomplete="current-password" />
                    <button type="button" id="pwEye" class="pw-eye" aria-label="Hold to show password" title="Hold to show password">
                        <svg id="eyeOpen" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                            <circle cx="12" cy="12" r="3" />
                        </svg>
                        <svg id="eyeClosed" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none" aria-hidden="true">
                            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" />
                            <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" />
                            <line x1="1" y1="1" x2="23" y2="23" />
                        </svg>
                    </button>
                </div>
                <div style="max-width:280px; margin-top:8px; text-align:right;">
                    @Html.ActionLink("Forgot password?", "ForgotPassword", "Account")
                </div>
            </div>
            <button type="submit" class="btn-accent btn-block-custom">Log In</button>
        }

        <p class="login-footer">Don't have an account? @Html.ActionLink("Register here", "Register", "Account")</p>
    </div>
</div>

<style>
    .pw-wrap {
        position: relative;
        display: block;
        width: 100%;
        max-width: 280px;
    }

        .pw-wrap .form-control-custom {
            padding-right: 46px;
        }

    .pw-eye {
        position: absolute;
        top: 0;
        right: 0;
        height: 100%;
        width: 44px;
        background: transparent;
        border: 0;
        padding: 0;
        cursor: pointer;
        color: #9fb3d9;
        display: flex;
        align-items: center;
        justify-content: center;
        -webkit-user-select: none;
        user-select: none;
        touch-action: none;
        -webkit-touch-callout: none;
        -webkit-tap-highlight-color: transparent;
    }

        .pw-eye:hover, .pw-eye:focus {
            color: #ffffff;
            outline: none;
        }
</style>

<script>
    (function () {
        var pw = document.getElementById('loginPassword');
        var eye = document.getElementById('pwEye');
        var open = document.getElementById('eyeOpen');
        var closed = document.getElementById('eyeClosed');
        if (!pw || !eye) return;

        // The password is only visible while the eye is being pressed.
        function reveal() { pw.type = 'text'; open.style.display = 'none'; closed.style.display = ''; }
        function hide() { pw.type = 'password'; open.style.display = ''; closed.style.display = 'none'; }

        eye.addEventListener('mousedown', function (e) { e.preventDefault(); reveal(); });
        eye.addEventListener('touchstart', function (e) { e.preventDefault(); reveal(); }, { passive: false });
        ['mouseup', 'mouseleave', 'touchend', 'touchcancel', 'blur'].forEach(function (ev) {
            eye.addEventListener(ev, hide);
        });
        document.addEventListener('mouseup', hide);
        eye.addEventListener('contextmenu', function (e) { e.preventDefault(); });

        // Keyboard: hold Space or Enter on the eye
        eye.addEventListener('keydown', function (e) {
            if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); reveal(); }
        });
        eye.addEventListener('keyup', hide);

        // Always send the form with the password hidden
        if (pw.form) pw.form.addEventListener('submit', hide);
    })();
</script>
