@{
    ViewBag.Title = "Reset Password";
}

<style>
    .pw-wrap {
        position: relative;
        display: block;
        width: 100%;
        max-width: 280px;
    }

        .pw-wrap .form-control-custom {
            padding-right: 46px;
        }

    .pw-eye {
        position: absolute;
        top: 0;
        right: 0;
        height: 100%;
        width: 44px;
        background: transparent;
        border: 0;
        padding: 0;
        cursor: pointer;
        color: #9fb3d9;
        display: flex;
        align-items: center;
        justify-content: center;
        -webkit-user-select: none;
        user-select: none;
        touch-action: none;
        -webkit-touch-callout: none;
        -webkit-tap-highlight-color: transparent;
    }

        .pw-eye:hover, .pw-eye:focus {
            color: #ffffff;
            outline: none;
        }

        .pw-eye .eye-closed {
            display: none;
        }

        .pw-eye.showing .eye-open {
            display: none;
        }

        .pw-eye.showing .eye-closed {
            display: inline;
        }
</style>

<div class="login-wrapper">
    <div class="login-card">
        <h2>Reset Password</h2>
        <p class="login-subtext">Choose a new password@(ViewBag.Username != null ? " for " + ViewBag.Username : "")</p>

        @if (ViewBag.Error != null)
        {
            <div class="login-error">@ViewBag.Error</div>
        }

        @if (ViewBag.LinkError != null)
        {
            <div class="login-error">@ViewBag.LinkError</div>
        }
        else
        {
            using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="token" value="@ViewBag.Token" />
                <div class="form-group-custom">
                    <label for="rpNew">New password</label>
                    <div class="pw-wrap">
                        <input type="password" id="rpNew" name="newPassword" class="form-control-custom" placeholder="At least 6 characters"
                               maxlength="50" autocomplete="new-password" required autofocus />
                        <button type="button" class="pw-eye" data-target="rpNew" aria-label="Hold to show password" title="Hold to show password">
                            <svg class="eye-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                            <svg class="eye-closed" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" /><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" /><line x1="1" y1="1" x2="23" y2="23" /></svg>
                        </button>
                    </div>
                </div>
                <div class="form-group-custom">
                    <label for="rpConfirm">Confirm new password</label>
                    <div class="pw-wrap">
                        <input type="password" id="rpConfirm" name="confirmPassword" class="form-control-custom" placeholder="Type it again"
                               maxlength="50" autocomplete="new-password" required />
                        <button type="button" class="pw-eye" data-target="rpConfirm" aria-label="Hold to show password" title="Hold to show password">
                            <svg class="eye-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                            <svg class="eye-closed" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" /><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" /><line x1="1" y1="1" x2="23" y2="23" /></svg>
                        </button>
                    </div>
                </div>
                <button type="submit" class="btn-accent btn-block-custom">Update Password</button>
            }
        }

        <p class="login-footer">Link not working? @Html.ActionLink("Request a new one", "ForgotPassword", "Account")</p>
        <p class="login-footer" style="margin-top:8px;">@Html.ActionLink("Back to log in", "Login", "Account")</p>
    </div>
</div>

<script>
    (function () {
        // Hold the eye to see the password; let go and it hides again
        var eyes = document.querySelectorAll('.pw-eye');
        for (var i = 0; i < eyes.length; i++) {
            (function (eye) {
                var input = document.getElementById(eye.getAttribute('data-target'));
                if (!input) return;
                function reveal() { input.type = 'text'; eye.className = 'pw-eye showing'; }
                function hide() { input.type = 'password'; eye.className = 'pw-eye'; }

                eye.addEventListener('mousedown', function (e) { e.preventDefault(); reveal(); });
                eye.addEventListener('touchstart', function (e) { e.preventDefault(); reveal(); }, { passive: false });
                ['mouseup', 'mouseleave', 'touchend', 'touchcancel', 'blur'].forEach(function (ev) { eye.addEventListener(ev, hide); });
                document.addEventListener('mouseup', hide);
                eye.addEventListener('contextmenu', function (e) { e.preventDefault(); });
                eye.addEventListener('keydown', function (e) { if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); reveal(); } });
                eye.addEventListener('keyup', hide);
                if (input.form) input.form.addEventListener('submit', hide);
            })(eyes[i]);
        }
    })();
</script>