@model SnisDrivingSchool.Models.ContactViewModel
@{
    ViewBag.Title = "Contact Us";
}

<div class="page-header-block">
    <h1>Contact Us</h1>
    <p>Questions about lessons, pricing, or booking? We'd love to hear from you.</p>
</div>

<div class="contact-layout">
    <div class="contact-info">
        <h2>Get In Touch</h2>

        <div class="contact-info-item">
            <strong>Address</strong>
            <p>
                68 Shepstone Street<br />
                Richmond, South Africa
            </p>
        </div>

        <div class="contact-info-item">
            <strong>Phone</strong>
            <p>
                <a href="tel:+27714446533">071 444 6533</a><br />
                <a href="tel:+27747577527">074 757 7527</a>
            </p>
        </div>

        <div class="contact-info-item">
            <strong>Email</strong>
            <p>
                <a href="mailto:snisdrivingacademy@gmail.com">snisdrivingacademy@gmail.com</a>
            </p>
        </div>

        <div class="contact-info-item">
            <strong>Opening Hours</strong>
            <p>
                Monday – Friday: 07:00 – 18:00<br />
                Saturday: 08:00 – 14:00<br />
                Sunday: Closed
            </p>
        </div>
    </div>

    <div class="contact-form-wrapper">
        <style>
            .contact-validation-summary.validation-summary-valid {
                display: none;
            }

            .contact-error-message {
                background-color: #4a1b1b;
                color: #ff9c9c;
                padding: 12px 16px;
                border-radius: 6px;
                margin-bottom: 20px;
                font-size: 14px;
            }
        </style>

        @if (!string.IsNullOrEmpty(ViewBag.Success as string))
        {
            <div class="contact-success-message">
                @ViewBag.Success
            </div>
        }
        @if (!string.IsNullOrEmpty(ViewBag.Error as string))
        {
            <div class="contact-error-message">
                @ViewBag.Error
            </div>
        }

        @using (Html.BeginForm("Contact", "Home", FormMethod.Post, new { @class = "form-2col" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(false, "", new { @class = "contact-validation-summary" })

            <div class="form-group-custom">
                @Html.LabelFor(m => m.Name)
                @Html.TextBoxFor(m => m.Name, new { @class = "form-control-custom" })
            </div>

            <div class="form-group-custom">
                @Html.LabelFor(m => m.Email)
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control-custom" })
            </div>

            <div class="form-group-custom full">
                @Html.LabelFor(m => m.Subject)
                @Html.TextBoxFor(m => m.Subject, new { @class = "form-control-custom" })
            </div>

            <div class="form-group-custom full">
                @Html.LabelFor(m => m.Message)
                @Html.TextAreaFor(m => m.Message, new { @class = "form-control-custom", rows = "5" })
            </div>

            <button type="submit" class="btn-accent btn-block-custom">Send Message</button>
        }
    </div>
</div>

<div class="map-embed">
    <iframe title="Sni's Driving School location"
            src="https://www.google.com/maps?q=68+Shepstone+Street%2C+Richmond%2C+South+Africa&output=embed"
            width="100%" height="350" style="border:0;" allowfullscreen="" loading="lazy">
    </iframe>
</div>
