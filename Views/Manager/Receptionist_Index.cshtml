@model SnisDrivingSchool.Models.RecHome
@{
    ViewBag.Title = "Reception Dashboard";
    string name = ViewBag.Name as string;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    int cancelWaiting = SnisDrivingSchool.Replacement.OpenRequestCount();
}

<style>
    .mh-head { margin: 10px 0 22px; }
    .mh-head h2 { margin: 0; font-size: 30px; }
    .mh-head p { margin: 4px 0 0; color: var(--text-muted); }
    .mh-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; }
    .mh-tile {
        display: flex; flex-direction: column; gap: 10px; padding: 20px; min-height: 190px;
        background: var(--navy-mid); border: 1px solid #2a3557; border-radius: 12px;
        color: var(--text-light); text-decoration: none; transition: .15s ease;
    }
    .mh-tile:hover { border-color: var(--accent-blue-light); transform: translateY(-2px); text-decoration: none; color: var(--text-light); }
    .mh-icon { width: 44px; height: 44px; border-radius: 10px; background: #1b3a5a; color: #9cc9ff; display: flex; align-items: center; justify-content: center; }
    .mh-tile h3 { margin: 0; font-size: 19px; }
    .mh-tile p { margin: 0; color: var(--text-muted); font-size: 13px; line-height: 1.4; }
    .mh-num { margin-top: auto; display: flex; align-items: baseline; gap: 8px; }
    .mh-num b { font-size: 28px; }
    .mh-num span { color: var(--text-muted); font-size: 13px; }
    .mh-flag { display: inline-block; padding: 2px 10px; border-radius: 12px; font-size: 12px; font-weight: 600; }
    .mh-flag.warn { background: #4a3a1b; color: #ffd89c; }
    .mh-flag.bad { background: #4a1b1b; color: #ff9c9c; }
    .mh-flag.ok { background: #1b4a2b; color: #9cffb0; }
    .mh-open { color: var(--accent-blue-light); font-size: 13px; font-weight: 600; }
</style>

<div class="mh-head">
    <h2>Reception dashboard</h2>
    <p>@(string.IsNullOrEmpty(name) ? "Welcome back." : "Welcome back, " + name + ".") Choose what you want to work on.</p>
</div>

@if (ViewBag.Error != null)
{
    <div class="login-error">@ViewBag.Error</div>
}

<div class="mh-grid">
    <a class="mh-tile" href="@Url.Action("Bookings", "Receptionist")">
        <div class="mh-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg></div>
        <h3>Bookings</h3>
        <p>All lessons. Book a lesson for a student.</p>
        <div class="mh-num"><b>@Model.ThisWeek</b><span>this week · @Model.Today today</span></div>
        <span class="mh-open">Open bookings &rarr;</span>
    </a>
    <a class="mh-tile" href="@Url.Action("CancelRequests", "Receptionist")">
        <div class="mh-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><line x1="15" y1="9" x2="9" y2="15" /><line x1="9" y1="9" x2="15" y2="15" /></svg></div>
        <h3>Cancellation requests</h3>
        <p>Instructors asking to cancel a lesson. Accept to give it to another instructor.</p>
        <div class="mh-num"><b>@cancelWaiting</b><span>waiting</span></div>
        @if (cancelWaiting > 0)
        {<span class="mh-flag warn">@cancelWaiting request@(cancelWaiting == 1 ? "" : "s") to answer</span>}
        else
        {<span class="mh-open">Open requests &rarr;</span>}
    </a>
    <a class="mh-tile" href="@Url.Action("Students", "Receptionist")">
        <div class="mh-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg></div>
        <h3>Students</h3>
        <p>Approve new accounts, check documents, register students.</p>
        <div class="mh-num"><b>@Model.Students</b><span>registered</span></div>
        @if (Model.Waiting > 0)
        {<span class="mh-flag warn">@Model.Waiting waiting for approval</span>}
        else
        {<span class="mh-open">Open students &rarr;</span>}
    </a>
    <a class="mh-tile" href="@Url.Action("Staff", "Receptionist")">
        <div class="mh-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="14" rx="2" /><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2" /></svg></div>
        <h3>Staff</h3>
        <p>Office staff and instructors. Record instructor leave.</p>
        <div class="mh-num"><b>@Model.Staff</b><span>people</span></div>
        @if (Model.OnLeave > 0)
        {<span class="mh-flag warn">@Model.OnLeave instructor@(Model.OnLeave == 1 ? "" : "s") on leave today</span>}
        else
        {<span class="mh-open">Open staff &rarr;</span>}
    </a>
    <a class="mh-tile" href="@Url.Action("Vehicles", "Receptionist")">
        <div class="mh-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 17h14v-5l-2-5H7l-2 5v5z" /><circle cx="7.5" cy="17.5" r="1.5" /><circle cx="16.5" cy="17.5" r="1.5" /><line x1="5" y1="12" x2="19" y2="12" /></svg></div>
        <h3>Vehicles</h3>
        <p>The fleet and licence disk dates. Add a vehicle.</p>
        <div class="mh-num"><b>@Model.Vehicles</b><span>vehicles</span></div>
        @if (Model.DisksDue > 0)
        {<span class="mh-flag bad">@Model.DisksDue disk@(Model.DisksDue == 1 ? "" : "s") expired or due soon</span>}
        else
        {<span class="mh-open">Open vehicles &rarr;</span>}
    </a>
    <a class="mh-tile" href="@Url.Action("Reports", "Receptionist")">
        <div class="mh-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2" /><line x1="2" y1="10" x2="22" y2="10" /></svg></div>
        <h3>Payments report</h3>
        <p>Who paid, when and how (card or EFT).</p>
        <div class="mh-num"><b>R @Model.PaidThisMonth.ToString("N0", inv)</b><span>@Model.Payments this month</span></div>
        <span class="mh-open">Open report &rarr;</span>
    </a>
</div>
