@model List<SnisDrivingSchool.Models.MgrVehicleRow>
@using SnisDrivingSchool.Models
@using Newtonsoft.Json
@{
    ViewBag.Title = "Manager - Vehicles";
    ViewBag.Active = "Vehicles";
    var form = ViewBag.Form as Dictionary<string, string> ?? new Dictionary<string, string>();
    Func<string, string> f = k => form.ContainsKey(k) ? form[k] : "";
    DateTime today = DateTime.Today;
    int expiredCount = Model.Count(v => v.DiskExpiry.HasValue && v.DiskExpiry.Value.Date < today);
    int dueCount = Model.Count(v => v.DiskExpiry.HasValue && v.DiskExpiry.Value.Date >= today && v.DiskExpiry.Value.Date <= today.AddDays(30));
    int availableCount = Model.Count(v => v.Status == "Available");
    bool canRemove = ViewBag.CanRemove == true;
}
@Html.Partial("_ManagerNav")

<div class="manager-header">
    <h2>Vehicles</h2>
    <p>View the school's vehicles, register new ones and keep licence disks up to date.</p>
</div>


<div class="manager-panel">
    <div class="manager-panel-header">
        <h3>Vehicles (<span id="rowCount">@Model.Count</span>)</h3>
        <button type="button" class="btn-accent" data-toggle="modal" data-target="#addVehicleModal">+ Add vehicle</button>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="contact-success-message">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="login-error">@TempData["Error"]</div>
    }
    @if (ViewBag.Error != null)
    {
        <div class="login-error">@ViewBag.Error</div>
    }

    <div class="m-stats">
        <div class="m-stat"><div class="l">Vehicles</div><div class="v">@Model.Count</div></div>
        <div class="m-stat"><div class="l">Available now</div><div class="v">@availableCount</div></div>
        <div class="m-stat"><div class="l">Disk due in 30 days</div><div class="v">@dueCount</div></div>
        <div class="m-stat"><div class="l">Disk expired</div><div class="v" style="@(expiredCount > 0 ? "color:#ff9c9c" : "")">@expiredCount</div></div>
    </div>

    <div class="search-bar">
        <input type="text" class="form-control-custom" data-table-search="vehiclesTable"
               placeholder="Search vehicles by registration, model or status" />
    </div>

    <div class="m-table-wrap">
        <table class="m-table" id="vehiclesTable">
            <thead>
                <tr>
                    <th>Vehicle ID</th>
                    <th>Registration no</th>
                    <th>Model</th>
                    <th>Licence code</th>
                    <th>Disk expiry date</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="7">No vehicles found.</td></tr>
                }
                @foreach (var v in Model)
                {
                    bool expired = v.DiskExpiry.HasValue && v.DiskExpiry.Value.Date < today;
                    bool due = !expired && v.DiskExpiry.HasValue && v.DiskExpiry.Value.Date <= today.AddDays(30);
                    <tr data-row="1">
                        <td>@v.VehicleId</td>
                        <td>@v.RegistrationNo</td>
                        <td>@v.Model</td>
                        <td>@v.LicenseCode</td>
                        <td>
                            @(v.DiskExpiry.HasValue ? v.DiskExpiry.Value.ToString("yyyy/MM/dd") : "")
                            @if (expired)
                            {
                                <span class="m-badge m-bad">Expired</span>
                            }
                            else if (due)
                            {
                                <span class="m-badge m-due">Due in @((v.DiskExpiry.Value.Date - today).Days) days</span>
                            }
                        </td>
                        <td><span class="m-badge @MgrUi.Badge(v.Status)">@v.Status</span></td>
                        <td style="white-space:nowrap">
                            <button type="button" class="m-act" data-dialog="editVehicleDialog"
                                    data-fields="@JsonConvert.SerializeObject(new { id = v.VehicleId, who = v.RegistrationNo, registrationNo = v.RegistrationNo, model = v.Model, licenseCode = v.LicenseCode, diskExpiry = v.DiskExpiry.HasValue ? v.DiskExpiry.Value.ToString("yyyy-MM-dd") : "", status = v.Status })">Edit</button>
                            @if (canRemove)
                            {
                                using (Html.BeginForm("RemoveVehicle", "Manager", FormMethod.Post, new { @class = "m-inline", onsubmit = "return confirm('Remove " + v.RegistrationNo + " from the list?');" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@v.VehicleId" />
                                    <button type="submit" class="m-act bad">Remove</button>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (ViewBag.OpenModal == true)
{
    <div id="openModalFlag" data-modal="addVehicleModal" style="display:none"></div>
}

<!-- Add Vehicle Modal -->
<div class="modal fade" id="addVehicleModal" tabindex="-1" role="dialog" aria-labelledby="addVehicleModalLabel">
    <div class="modal-dialog modal-wide" role="document">
        <div class="modal-content modal-content-custom">
            @using (Html.BeginForm("AddVehicle", "Manager", FormMethod.Post, new { autocomplete = "off" }))
            {
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title" id="addVehicleModalLabel">Register new vehicle</h4>
                </div>
                <div class="modal-body form-2col">
                    @if (ViewBag.ModalError != null)
                    {
                        <div class="login-error">@ViewBag.ModalError</div>
                    }
                    <div class="form-group-custom">
                        <label>Registration number</label>
                        <input type="text" name="registrationNo" class="form-control-custom" maxlength="20" value="@f("registrationNo")" />
                        <span class="m-hint">For example ND 202 KZN.</span>
                    </div>
                    <div class="form-group-custom">
                        <label>Model</label>
                        <input type="text" name="model" class="form-control-custom" maxlength="50" value="@f("model")" />
                    </div>
                    <div class="form-group-custom">
                        <label>Licence code</label>
                        <select name="licenseCode" class="form-control-custom">
                            <option value="">-- Select licence code --</option>
                            <option value="8" @(f("licenseCode") == "8" ? "selected" : "")>Code 8</option>
                            <option value="10" @(f("licenseCode") == "10" ? "selected" : "")>Code 10</option>
                            <option value="14" @(f("licenseCode") == "14" ? "selected" : "")>Code 14</option>
                        </select>
                    </div>
                    <div class="form-group-custom">
                        <label>Licence disk expiry date</label>
                        <input type="date" name="diskExpiry" class="form-control-custom"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")" value="@f("diskExpiry")" />
                    </div>
                    <div class="form-group-custom">
                        <label>Vehicle status</label>
                        <select name="status" class="form-control-custom">
                            <option value="Available" @(f("status") == "Available" || f("status") == "" ? "selected" : "")>Available</option>
                            <option value="In Use" @(f("status") == "In Use" ? "selected" : "")>In Use</option>
                            <option value="Maintenance" @(f("status") == "Maintenance" ? "selected" : "")>Maintenance</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-outline-accent" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-accent">Save vehicle</button>
                </div>
            }
        </div>
    </div>
</div>

<!-- Edit vehicle (e.g. new licence disk expiry date) -->
<dialog class="m-dialog dlg-wide" id="editVehicleDialog">
    @using (Html.BeginForm("EditVehicle", "Manager", FormMethod.Post, new { autocomplete = "off" }))
    {
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" />
        <div class="m-dialog-head"><h4>Edit vehicle <span data-show="who"></span></h4><button type="button" data-close-dialog>&times;</button></div>
        <div class="m-dialog-body form-2col">
            <div class="form-group-custom"><label>Registration number</label><input type="text" name="registrationNo" class="form-control-custom" maxlength="20" required /></div>
            <div class="form-group-custom"><label>Model</label><input type="text" name="model" class="form-control-custom" maxlength="50" required /></div>
            <div class="form-group-custom">
                <label>Licence code</label>
                <select name="licenseCode" class="form-control-custom" style="height:42px">
                    <option value="8">Code 8</option><option value="10">Code 10</option><option value="14">Code 14</option>
                </select>
            </div>
            <div class="form-group-custom">
                <label>Licence disk expiry date</label>
                <input type="date" name="diskExpiry" class="form-control-custom" required />
                <span class="m-hint">After renewing the disk, enter the new expiry date here.</span>
            </div>
            <div class="form-group-custom">
                <label>Vehicle status</label>
                <select name="status" class="form-control-custom" style="height:42px">
                    <option value="Available">Available</option><option value="In Use">In Use</option><option value="Maintenance">Maintenance</option>
                </select>
            </div>
        </div>
        <div class="m-dialog-foot"><button type="button" class="btn-outline-accent" data-close-dialog>Cancel</button><button type="submit" class="btn-accent">Save changes</button></div>
    }
</dialog>
