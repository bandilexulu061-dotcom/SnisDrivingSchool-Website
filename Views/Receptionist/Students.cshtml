@model IEnumerable<SnisDrivingSchool.Models.StudentRow>
@{
    ViewBag.Title = "Receptionist - Students";
    ViewBag.Active = "Students";
    int waiting = Model.Count(x => x.Stage == "Waiting");
    int notVerified = Model.Count(x => x.Stage == "Verify");
}
<style>
    .ap-badge { display: inline-block; padding: 2px 10px; border-radius: 12px; font-size: 12px; font-weight: 600; white-space: nowrap; }
    .ap-ok { background: #1b4a2b; color: #9cffb0; }
    .ap-warn { background: #4a3a1b; color: #ffd89c; }
    .ap-bad { background: #4a1b1b; color: #ff9c9c; }
    .ap-info { background: #1b3a5a; color: #9cc9ff; }
    .ap-btn { background: transparent; border: 1px solid #2a3a66; color: var(--text-light); border-radius: 6px; padding: 3px 10px; font-size: 12px; cursor: pointer; margin: 4px 4px 0 0; }
    .ap-btn.ok { border-color: #1e7a46; color: #9cffb0; }
    .ap-btn.bad { border-color: #7a2a2a; color: #ff9c9c; }
    .ap-note { display: block; color: var(--text-muted); font-size: 11px; max-width: 200px; white-space: normal; margin-top: 3px; }
    .ap-banner { background: #3a2e12; border: 1px solid #6a5420; color: #ffe2a8; border-radius: 8px; padding: 10px 14px; margin-bottom: 14px; }
    dialog.ap-dialog { background: var(--navy-mid); color: var(--text-light); border: 1px solid #2a3557; border-radius: 10px; padding: 0; width: 440px; max-width: calc(100vw - 32px); }
    dialog.ap-dialog::backdrop { background: rgba(5, 10, 25, .7); }
    .ap-dialog .h { padding: 14px 20px; border-bottom: 1px solid #2a3557; font-size: 18px; }
    .ap-dialog .b { padding: 16px 20px; }
    .ap-dialog .f { padding: 12px 20px; border-top: 1px solid #2a3557; text-align: right; }
    .ap-dialog textarea { width: 100%; max-width: none; min-height: 90px; box-sizing: border-box; }
</style>
@Html.Partial("_ReceptionistNav")

<div class="manager-header">
    <h2>Students</h2>
    <p>Registered students: check their documents, approve new accounts and register new students.</p>
</div>

<div class="manager-panel">
    <div class="manager-panel-header">
        <h3>Students</h3>
        <button type="button" class="btn-accent" data-toggle="modal" data-target="#addStudentModal">+ Add student</button>
    </div>

    <div class="search-bar">
        <input type="text" id="tableSearch" class="form-control-custom" placeholder="Search students by name, email, or phone" />
    </div>

    @if (waiting > 0)
    {
        <div class="ap-banner"><b>@waiting student@(waiting == 1 ? " is" : "s are") waiting for approval.</b> They are at the top of the list. Check their ID@(waiting == 1 ? "" : "s") and documents, then approve or not approve.</div>
    }
    @if (notVerified > 0)
    {
        <p style="color:var(--text-muted);font-size:13px;margin:-4px 0 12px;">@notVerified more registered but haven't entered their verification code yet.</p>
    }
    @if (TempData["Success"] != null)
    {
        <div class="contact-success-message">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="login-error">@TempData["Error"]</div>
    }
    @if (ViewBag.Error != null)
    {
        <div class="login-error">@ViewBag.Error</div>
    }

    <div class="m-table-wrap">
        <table class="m-table" id="studentsTable">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Account</th>
                    <th>ID number</th>
                    <th>Age</th>
                    <th>Licence eligibility</th>
                    <th>Current licence</th>
                    <th>ID PDF</th>
                    <th>Licence PDF</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>Address</th>
                    <th>Username</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var x in Model)
                {
                    <tr>
                        <td>@x.StudentID</td>
                        <td>@x.StudentFirstName @x.StudentLastName</td>
                        @{ var stage = SnisDrivingSchool.StudentApproval.ParseStage(x.Stage); }
                        <td style="white-space:nowrap">
                            <span class="m-badge m-@SnisDrivingSchool.StudentApproval.StageCss(stage)">@SnisDrivingSchool.StudentApproval.StageText(stage)</span>
                            @if (stage == SnisDrivingSchool.StudentApproval.Stage.Rejected && !string.IsNullOrEmpty(x.ApprovalNote))
                            {
                                <span class="ap-note">"@x.ApprovalNote"</span>
                            }
                            <br />
                            @if (stage == SnisDrivingSchool.StudentApproval.Stage.Waiting || stage == SnisDrivingSchool.StudentApproval.Stage.Rejected)
                            {
                                using (Html.BeginForm("ApproveStudent", "Receptionist", new { id = x.StudentID }, FormMethod.Post, new { style = "display:inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="m-act ok" disabled="@(x.IdDocumentId == 0 ? "disabled" : null)" title="@(x.IdDocumentId == 0 ? "Upload the ID document first" : null)">Approve</button>
                                }
                            }
                            @if (stage != SnisDrivingSchool.StudentApproval.Stage.Rejected)
                            {
                                <button type="button" class="m-act bad" data-disapprove="@x.StudentID" data-name="@x.StudentFirstName @x.StudentLastName">Not approve</button>
                            }
                        </td>
                        @{ var sid = SnisDrivingSchool.SaIdNumber.Parse(x.IdNumber); }
                        <td>@x.IdNumber</td>
                        <td>@(sid.IsValid ? sid.Age.ToString() : "")</td>
                        <td><span class="elig @sid.EligibilityCss" title="@sid.EligibilityText">@sid.EligibilityLabel</span></td>
                        <td>@SnisDrivingSchool.Licence.StatusText(x.LicenceStatus)</td>
                        <td style="white-space:nowrap">
                            @if (x.IdDocumentId > 0)
                            {
                                <a href="@Url.Action("Open", "Documents", new { id = x.IdDocumentId })" target="_blank" class="doc-act">View PDF</a>
                            }
                            else
                            {
                                <span class="doc-missing">Missing</span>
                            }
                            <button type="button" class="doc-act" data-upload-student="@x.StudentID" data-upload-name="@(x.StudentFirstName + " " + x.StudentLastName)" data-upload-type="ID">Upload</button>
                        </td>
                        <td style="white-space:nowrap">
                            @if (!SnisDrivingSchool.Licence.NeedsDocument(x.LicenceStatus) && SnisDrivingSchool.Licence.IsStatus(x.LicenceStatus))
                            {
                                <span style="color:var(--text-muted);font-size:12px;margin-right:4px;">Not needed</span>
                            }
                            else if (x.DocumentId > 0)
                            {
                                <a href="@Url.Action("Open", "Documents", new { id = x.DocumentId })" target="_blank" class="doc-act">View PDF</a>
                            }
                            else
                            {
                                <span class="doc-missing">Missing</span>
                            }
                            <button type="button" class="doc-act" data-upload-student="@x.StudentID" data-upload-name="@(x.StudentFirstName + " " + x.StudentLastName)" data-upload-status="@SnisDrivingSchool.Licence.Normalize(x.LicenceStatus)">Upload</button>
                        </td>
                        <td>@x.StudentPhoneNo</td>
                        <td>@x.StudentEmailAdress</td>
                        <td>@x.StudentAdress</td>
                        <td>@x.StudentUserName</td>
                        <td>@x.Status</td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="14">No students found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- "Not approve" pop-up: a reason is required (the student sees it) -->
<dialog class="ap-dialog" id="disapproveDialog">
    @using (Html.BeginForm("DisapproveStudent", "Receptionist", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" id="apId" />
        <div class="h">Not approve <span id="apName"></span>?</div>
        <div class="b">
            <label for="apReason">Reason (the student will see this)</label>
            <textarea name="reason" id="apReason" class="form-control-custom" required minlength="5" maxlength="300"
                      placeholder="e.g. The ID document is not readable. Please upload a clearer copy."></textarea>
        </div>
        <div class="f">
            <button type="button" class="btn-outline-accent" onclick="document.getElementById('disapproveDialog').close()">Cancel</button>
            <button type="submit" class="btn-accent">Save</button>
        </div>
    }
</dialog>
<script>
    (function () {
        var dlg = document.getElementById('disapproveDialog');
        Array.prototype.forEach.call(document.querySelectorAll('[data-disapprove]'), function (btn) {
            btn.addEventListener('click', function () {
                document.getElementById('apId').value = btn.getAttribute('data-disapprove');
                document.getElementById('apName').textContent = btn.getAttribute('data-name');
                document.getElementById('apReason').value = '';
                dlg.showModal();
            });
        });
    })();
</script>

<!-- Add Student Modal -->
@{
    var form = ViewBag.Form as Dictionary<string, string> ?? new Dictionary<string, string>();
    Func<string, string> val = k => form.ContainsKey(k) ? form[k] : "";
}
<div class="modal fade" id="addStudentModal" tabindex="-1" role="dialog" aria-labelledby="addStudentModalLabel">
    <div class="modal-dialog modal-wide" role="document">
        <div class="modal-content modal-content-custom">
            @using (Html.BeginForm("AddStudent", "Receptionist", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title" id="addStudentModalLabel">Register new student</h4>
                </div>
                <div class="modal-body form-2col">
                    @if (ViewBag.ModalError != null && (ViewBag.OpenModal as string) == "student")
                    {
                        <div class="login-error">@ViewBag.ModalError</div>
                    }
                    <div class="form-group-custom">
                        <label>First name</label>
                        <input type="text" name="firstName" class="form-control-custom" maxlength="50" value="@val("firstName")" required />
                    </div>
                    <div class="form-group-custom">
                        <label>Surname</label>
                        <input type="text" name="lastName" class="form-control-custom" maxlength="50" value="@val("lastName")" required />
                    </div>
                    <div class="form-group-custom">
                        <label>Phone number</label>
                        <input type="text" name="phone" class="form-control-custom" placeholder="e.g. 0821234567" value="@val("phone")" required />
                    </div>
                    <div class="form-group-custom">
                        <label>Email</label>
                        <input type="email" name="email" class="form-control-custom" maxlength="50" value="@val("email")" required />
                    </div>
                    <div class="form-group-custom">
                        <label>Username</label>
                        <input type="text" name="userName" class="form-control-custom" maxlength="50" value="@val("userName")" required />
                    </div>
                    <div class="form-group-custom">
                        <label>Address</label>
                        <input type="text" name="address" class="form-control-custom" maxlength="50" value="@val("address")" />
                    </div>
                    <div class="form-group-custom">
                        <label>South African ID number</label>
                        <input type="text" name="idNumber" class="form-control-custom" maxlength="13" inputmode="numeric" value="@val("idNumber")" />
                        <small style="display:block;color:var(--text-muted);margin-top:4px;">Must be 17 or older (learner's licence age).</small>
                    </div>
                    <div class="form-group-custom">
                        <label>Current licence</label>
                        <select name="licenceStatus" class="form-control-custom" >
                    <option value="">-- Choose --</option>
                    @foreach (var o in SnisDrivingSchool.Licence.StatusOptions)
                    {
                        <option value="@o.Key" @(val("licenceStatus") == o.Key ? "selected" : "")>@o.Value</option>
                    }
                </select>
                    </div>
                    <div class="form-group-custom">
                        <label>ID document PDF</label>
                        <input type="file" name="idDocument" accept="application/pdf,.pdf" class="form-control-custom" required />
                        <small style="display:block;color:var(--text-muted);margin-top:4px;">Copy of the student's ID book or card. PDF up to 3 MB.</small>
                    </div>
                    <div class="form-group-custom">
                        <label>Licence PDF</label>
                        <input type="file" name="licenceDocument" accept="application/pdf,.pdf" class="form-control-custom" required />
                        <small style="display:block;color:var(--text-muted);margin-top:4px;">Copy of the licence chosen above. PDF up to 3 MB.</small>
                    </div>
                    <div class="form-group-custom">
                        <label>Password</label>
                        <input type="password" name="password" id="studentPassword" class="form-control-custom" maxlength="50" placeholder="At least 6 characters" autocomplete="new-password" required />
                    </div>
                    <div class="form-group-custom">
                        <label>Confirm password</label>
                        <input type="password" name="confirmPassword" id="studentConfirmPassword" class="form-control-custom" maxlength="50" placeholder="Repeat the password" autocomplete="new-password" required />
                    </div>
                    <div class="form-group-custom">
                        <label style="margin-right:15px;"><input type="radio" name="pwView" value="hide" checked /> Hide passwords</label>
                        <label><input type="radio" name="pwView" value="show" /> Show passwords</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-outline-accent" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-accent">Save student</button>
                </div>
            }
        </div>
    </div>
</div>

@section scripts {
    <script>
        // This section is rendered in <head>, before jQuery and the page markup exist,
        // so wait until the page has finished loading.
        document.addEventListener("DOMContentLoaded", function () {
            if ("@(ViewBag.OpenModal as string)" === "student") { $("#addStudentModal").modal("show"); }

            var pwRadios = document.querySelectorAll('input[name="pwView"]');
            var pwBoxes = [document.getElementById("studentPassword"), document.getElementById("studentConfirmPassword")];
            pwRadios.forEach(function (radio) {
                radio.addEventListener("change", function () {
                    var show = this.value === "show" && this.checked;
                    pwBoxes.forEach(function (b) { if (b) b.type = show ? "text" : "password"; });
                });
            });

            var search = document.getElementById("tableSearch");
            if (search) {
                search.addEventListener("keyup", function () {
                    var q = this.value.toLowerCase();
                    document.querySelectorAll("#studentsTable tbody tr").forEach(function (row) {
                        row.style.display = row.textContent.toLowerCase().indexOf(q) > -1 ? "" : "none";
                    });
                });
            }
        });
    </script>
}

<style>
    .elig { display: inline-block; padding: 2px 10px; border-radius: 12px; font-size: 12px; font-weight: 600; white-space: nowrap; }
    .elig.m-ok { background: #1b4a2b; color: #9cffb0; }
    .elig.m-warn { background: #4a3a1b; color: #ffd89c; }
    .elig.m-bad { background: #4a1b1b; color: #ff9c9c; }
</style>

@Html.Partial("_LicenceUploadDialog")

<script>
    // "None" (no licence yet): there is no licence PDF to upload, so hide that box
    (function () {
        Array.prototype.forEach.call(document.querySelectorAll('select[name=licenceStatus]'), function (sel) {
            var form = sel.form, file = form && form.querySelector('input[type=file][name=licenceDocument]');
            if (!file) return;
            var box = file.closest('.form-group-custom, .pf-doc') || file.parentNode, wasRequired = file.required;
            function sync() {
                var none = sel.value === 'None';
                box.style.display = none ? 'none' : '';
                file.required = wasRequired && !none;
                if (none) file.value = '';
            }
            sel.addEventListener('change', sync);
            sync();
        });
    })();
</script>
