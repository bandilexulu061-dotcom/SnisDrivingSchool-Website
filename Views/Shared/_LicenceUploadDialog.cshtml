@* Staff pop-up to record a learner's licence and upload its PDF (Manager and Receptionist Students pages).
   Opened by any button with data-upload-student="id" data-upload-name="name" data-upload-status="Learner|Code 8|...". *@

<style>
    .doc-act {
        display: inline-block; background: transparent; border: 1px solid #2a3a66; color: var(--text-light, #f4f6fb);
        border-radius: 6px; padding: 3px 10px; font-size: 12px; cursor: pointer; margin-right: 4px; text-decoration: none;
    }
    .doc-act:hover { border-color: var(--accent-blue, #2e6ff2); color: var(--text-light, #f4f6fb); text-decoration: none; }
    .doc-missing { display: inline-block; padding: 2px 10px; border-radius: 12px; font-size: 12px; font-weight: 600; background: #4a1b1b; color: #ff9c9c; margin-right: 4px; }
    dialog.lu-dialog {
        background: var(--navy-mid, #14213d); color: var(--text-light, #f4f6fb); border: 1px solid #2a3557;
        border-radius: 10px; padding: 0; width: 440px; max-width: calc(100vw - 32px);
    }
    dialog.lu-dialog::backdrop { background: rgba(5, 10, 25, .7); }
    .lu-head { padding: 14px 20px; border-bottom: 1px solid #2a3557; display: flex; align-items: center; }
    .lu-head h4 { margin: 0; font-size: 18px; }
    .lu-head button { margin-left: auto; background: none; border: 0; color: var(--text-muted, #b8c2d9); font-size: 22px; cursor: pointer; }
    .lu-body { padding: 16px 20px; }
    .lu-body .form-control-custom { width: 100%; max-width: none; box-sizing: border-box; }
    .lu-body select.form-control-custom { height: 42px; }
    .lu-foot { padding: 12px 20px; border-top: 1px solid #2a3557; text-align: right; }
    .lu-foot .btn-outline-accent { margin-right: 8px; }
    .lu-hint { display: block; color: var(--text-muted, #b8c2d9); font-size: 12px; margin-top: 4px; }
</style>

<dialog class="lu-dialog" id="licenceUploadDialog">
    @using (Html.BeginForm("Upload", "Documents", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        <input type="hidden" name="studentId" id="luStudentId" />
        <input type="hidden" name="docType" id="luType" value="Licence" />
        <div class="lu-head"><h4><span id="luTitle">Licence</span> for <span id="luName"></span></h4><button type="button" data-close-upload aria-label="Close">&times;</button></div>
        <div class="lu-body">
            <div class="form-group-custom" id="luStatusGroup">
                <label>Licence the learner has</label>
                <select name="licenceStatus" id="luStatus" class="form-control-custom" required>
                    <option value="">-- Choose --</option>
                    @foreach (var o in SnisDrivingSchool.Licence.StatusOptions)
                    {
                        <option value="@o.Key">@o.Value</option>
                    }
                </select>
            </div>
            <div class="form-group-custom" id="luFileGroup">
                <label id="luFileLabel">PDF copy of that licence</label>
                <input type="file" name="document" id="luFile" accept="application/pdf,.pdf" class="form-control-custom" required />
                <span class="lu-hint">PDF up to 3 MB. It replaces the learner's current document.</span>
            </div>
        </div>
        <div class="lu-foot">
            <button type="button" class="btn-outline-accent" data-close-upload>Cancel</button>
            <button type="submit" class="btn-accent">Save</button>
        </div>
    }
</dialog>

<script>
    (function () {
        var dlg = document.getElementById('licenceUploadDialog');
        if (!dlg) return;
        Array.prototype.forEach.call(document.querySelectorAll('[data-upload-student]'), function (btn) {
            btn.addEventListener('click', function () {
                document.getElementById('luStudentId').value = btn.getAttribute('data-upload-student');
                document.getElementById('luName').textContent = btn.getAttribute('data-upload-name');
                var isId = btn.getAttribute('data-upload-type') === 'ID';
                var status = document.getElementById('luStatus');
                status.value = btn.getAttribute('data-upload-status') || '';
                status.required = !isId;
                document.getElementById('luType').value = isId ? 'ID' : 'Licence';
                document.getElementById('luStatusGroup').style.display = isId ? 'none' : '';
                document.getElementById('luTitle').textContent = isId ? 'ID document' : 'Licence';
                document.getElementById('luFileLabel').textContent = isId ? 'PDF copy of the ID document' : 'PDF copy of that licence';
                syncNone();
                if (dlg.showModal) dlg.showModal(); else dlg.setAttribute('open', 'open');
            });
        });
        // "None" (no licence yet): nothing to upload
        function syncNone() {
            var none = document.getElementById('luType').value !== 'ID' && document.getElementById('luStatus').value === 'None';
            document.getElementById('luFileGroup').style.display = none ? 'none' : '';
            document.getElementById('luFile').required = !none;
        }
        document.getElementById('luStatus').addEventListener('change', syncNone);
        Array.prototype.forEach.call(dlg.querySelectorAll('[data-close-upload]'), function (b) {
            b.addEventListener('click', function () { if (dlg.close) dlg.close(); else dlg.removeAttribute('open'); });
        });
    })();
</script>
