@model SnisDrivingSchool.Models.BookingHistoryViewModel
@using SnisDrivingSchool.Models
@{
    Layout = "~/Views/Student/_StudentLayout.cshtml";
    ViewBag.Title = "Booking History";
    ViewBag.Active = "History";
    var s = Model.Student;
    int total = Model.PaidCount + Model.UnpaidCount + Model.CancelledCount;
    Func<int, string> pct = n => total > 0 ? Math.Round(100.0 * n / total).ToString("0") + "%" : "0%";
}

<style>
    .bh-chart { display: flex; align-items: center; gap: 36px; flex-wrap: wrap; }
    .bh-legend { list-style: none; margin: 0; padding: 0; }
    .bh-legend li { margin: 10px 0; font-size: 15px; color: var(--text-light); }
    .bh-legend span.n { color: var(--text-muted); margin-left: 6px; }
    .bh-sw { display: inline-block; width: 14px; height: 14px; border-radius: 4px; margin-right: 8px; vertical-align: -1px; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    #pie { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    @@media print { .bh-legend li { color: #000 !important; } }
</style>

<div class="st-head">
    <div>
        <h2>Booking history</h2>
        <p>Sni's Driving School · all bookings (paid, unpaid and cancelled) · generated @Model.Generated.ToString("d MMMM yyyy, HH:mm")</p>
    </div>
    <div class="st-head-actions st-no-print">
        <a class="st-btn" href="@Url.Action("Bookings", "Student")">&larr; My bookings</a>
        <button type="button" class="st-btn primary" onclick="window.print()">Print</button>
    </div>
</div>

<div class="st-grid-2">
    <div class="st-card">
        <h3>Student</h3>
        <p class="st-sub">Details on file</p>
        @if (s != null)
        {
            <dl class="st-dl">
                <dt>Name</dt><dd>@s.Name @s.Surname</dd>
                <dt>Student number</dt><dd>@s.StudentId</dd>
                <dt>Username</dt><dd>@s.UserName</dd>
                <dt>Phone</dt><dd>@s.PhoneNumber</dd>
                <dt>Email</dt><dd>@s.Email</dd>
                <dt>Address</dt><dd>@(string.IsNullOrEmpty(s.Address) ? "-" : s.Address)</dd>
            </dl>
        }
    </div>

    <div class="st-card">
        <h3>Overview</h3>
        <p class="st-sub">@total booking@(total == 1 ? "" : "s") in total</p>
        <div class="bh-chart">
            <svg id="pie" width="170" height="170" viewBox="-100 -100 200 200"
                 data-paid="@Model.PaidCount" data-unpaid="@Model.UnpaidCount" data-cancelled="@Model.CancelledCount"></svg>
            <ul class="bh-legend">
                <li><span class="bh-sw" style="background:#199e70"></span>Paid <b>@Model.PaidCount</b><span class="n">@pct(Model.PaidCount)</span></li>
                <li><span class="bh-sw" style="background:#c98500"></span>Not paid yet <b>@Model.UnpaidCount</b><span class="n">@pct(Model.UnpaidCount)</span></li>
                <li><span class="bh-sw" style="background:#d95926"></span>Cancelled <b>@Model.CancelledCount</b><span class="n">@pct(Model.CancelledCount)</span></li>
            </ul>
        </div>
    </div>
</div>

<div class="st-card" style="margin-top:18px;">
    <h3>All bookings</h3>
    <p class="st-sub">Newest first</p>
    <div class="st-table-wrap">
        <table class="st-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Lesson</th>
                    <th>Date &amp; time</th>
                    <th>Status</th>
                    <th>Payment</th>
                    <th class="num">Price</th>
                    <th class="num">Paid</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Bookings.Count == 0)
                {
                    <tr><td colspan="7" class="st-empty">No bookings yet.</td></tr>
                }
                @foreach (var b in Model.Bookings)
                {
                    <tr>
                        <td>@b.BookingId</td>
                        <td>@b.PackageName<span class="st-small">@(string.IsNullOrEmpty(b.InstructorName) ? "No instructor" : "with " + b.InstructorName)</span></td>
                        <td class="nowrap">@b.BookingDate.ToString("yyyy/MM/dd")<span class="st-small">@b.TimeText</span></td>
                        <td><span class="st-badge @StudentUi.StatusCss(b)">@b.DisplayStatus</span></td>
                        <td><span class="st-badge @StudentUi.PayCss(b)">@StudentUi.PayText(b)</span></td>
                        <td class="num">@Fmt.Rand(b.Price)</td>
                        <td class="num">@(b.Paid ? Fmt.Rand(b.PaidAmount ?? 0m) : b.Refunded ? "refunded" : "-")@if (b.PaidOn.HasValue && b.Paid) {<span class="st-small">@b.PaidOn.Value.ToString("yyyy/MM/dd")</span>}</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    (function () {
        var svg = document.getElementById('pie');
        var items = [
            { n: parseInt(svg.getAttribute('data-paid'), 10), c: '#199e70' },
            { n: parseInt(svg.getAttribute('data-unpaid'), 10), c: '#c98500' },
            { n: parseInt(svg.getAttribute('data-cancelled'), 10), c: '#d95926' }
        ];
        var total = items.reduce(function (a, i) { return a + i.n; }, 0);
        var NS = 'http://www.w3.org/2000/svg';
        function add(tag, attrs) {
            var el = document.createElementNS(NS, tag);
            for (var k in attrs) { el.setAttribute(k, attrs[k]); }
            svg.appendChild(el);
        }
        // Donut: a ring of arcs with a hole in the middle
        var R = 90, r = 58;
        if (total === 0) {
            add('circle', { r: (R + r) / 2, fill: 'none', stroke: '#2a3557', 'stroke-width': R - r });
        } else {
            var start = -Math.PI / 2;
            items.forEach(function (it) {
                if (!it.n) return;
                var angle = 2 * Math.PI * it.n / total;
                if (it.n === total) { add('circle', { r: (R + r) / 2, fill: 'none', stroke: it.c, 'stroke-width': R - r }); return; }
                var end = start + angle, large = angle > Math.PI ? 1 : 0;
                function pt(rad, a) { return (rad * Math.cos(a)).toFixed(2) + ' ' + (rad * Math.sin(a)).toFixed(2); }
                add('path', {
                    d: 'M' + pt(R, start) + ' A' + R + ' ' + R + ' 0 ' + large + ' 1 ' + pt(R, end) +
                       ' L' + pt(r, end) + ' A' + r + ' ' + r + ' 0 ' + large + ' 0 ' + pt(r, start) + ' Z',
                    fill: it.c
                });
                start = end;
            });
        }
        var t = document.createElementNS(NS, 'text');
        t.setAttribute('text-anchor', 'middle'); t.setAttribute('dy', '10'); t.setAttribute('font-size', '30'); t.setAttribute('font-weight', '700');
        t.setAttribute('fill', window.matchMedia && window.matchMedia('print').matches ? '#000' : '#fff');
        t.textContent = total;
        svg.appendChild(t);
    })();
</script>

@if (Model.AutoPrint)
{
    <script>
        window.addEventListener('load', function () { setTimeout(function () { window.print(); }, 500); });
    </script>
}
